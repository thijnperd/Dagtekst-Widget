   light:{bg1:'#e8c4a0',bg2:'#d47858',text:'#fdf8f2',ornament:'#f8e4d0'},
   dark: {bg1:'#3d1a10',bg2:'#5c2820',text:'#f9ede0',ornament:'#e8a070'}},
  {id:'for',name:'Woud',
   light:{bg1:'#a8c4a0',bg2:'#607848',text:'#f8f6f0',ornament:'#d8e8c8'},
