// ── MOBILE NAV ─────────────────────────────
(function(){
  const isMobile = () => window.innerWidth <= 700;

  // Elements
  const leftEl  = document.querySelector('.left');
  const rightEl = document.querySelector('.right');
  const coEl    = document.querySelector('.co');
  const wsEl    = document.querySelector('.ws');
  const pctrlEl = document.querySelector('.pctrl');

  let current = 'settings';

  function applyView(tab){
    current = tab;
    if (!isMobile()) {
      // Desktop: reset everything
      leftEl.classList.remove('mob-hidden','mob-visible');
      rightEl.classList.remove('mob-hidden','mob-visible');
      coEl.style.display = '';
      wsEl.style.display = '';
      pctrlEl.style.display = '';
      return;
    }

    // Update nav buttons
    ['settings','preview','code'].forEach(t => {
      document.getElementById('mn-'+t).classList.toggle('on', t===tab);
    });

    if (tab === 'settings') {
      leftEl.classList.add('mob-visible');
      leftEl.classList.remove('mob-hidden');
      rightEl.classList.add('mob-hidden');
      rightEl.classList.remove('mob-visible');
    } else {
      leftEl.classList.add('mob-hidden');
      leftEl.classList.remove('mob-visible');
      rightEl.classList.add('mob-visible');
      rightEl.classList.remove('mob-hidden');
      // Show/hide sub-sections within right panel
      wsEl.style.display    = (tab === 'preview') ? 'flex' : 'none';
      pctrlEl.style.display = (tab === 'preview') ? 'flex' : 'none';
      coEl.style.display    = (tab === 'code')    ? 'block': 'none';
    }
  }

  window.mobTab = function(tab){ applyView(tab); };

  // On resize switch back to desktop layout if needed
  window.addEventListener('resize', () => {
    if (!isMobile()) applyView(current);
    else applyView(current);
  });

  // Init on load
  if (isMobile()) applyView('settings');
})();
