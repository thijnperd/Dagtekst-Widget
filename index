  {id:'tea',name:'Theegroen',
   light:{bg1:'#b8d0c0',bg2:'#90b098',text:'#f4faf4',ornament:'#d4e8d8'},
   dark: {bg1:'#102018',bg2:'#182c20',text:'#d8f0e0',ornament:'#70a880'}},
];

// ── ORNAMENTS ──────────────────────────────
const ORNS=['\u201C','\u2018','\u275D','\u2767','\u2741','\u2740','\u273F','\u2736','\u2727','\u2606','\u2712','\u2042','\u00A7','\u00B6','\u2666','\u2660','\u2663'];

// ── INIT ───────────────────────────────────
function init(){
  buildThemes();
  buildOrns();
  syncColors();
  up();
  gen();
}

function buildThemes(){
  const g=document.getElementById('themeGrid');
  PRESETS.forEach((p,i)=>{
    const d=document.createElement('div');
    d.className='tc'+(i===0?' on':'');
    d.id='tc-'+p.id;
    d.onclick=()=>applyPreset(p);
    d.innerHTML=`<div class="tp" style="background:linear-gradient(135deg,${p.light.bg1},${p.light.bg2})"><div class="tp-orn" style="color:${p.light.ornament}">\u201C</div><div class="tp-txt" style="color:${p.light.text}">${p.name}</div></div><div class="tn">${p.name}</div>`;
    g.appendChild(d);
  });
}

function buildOrns(){
  const g=document.getElementById('ornGrid');
  ORNS.forEach(c=>{
    const b=document.createElement('button');
    b.className='ob'+(c===S.orn?' on':'');
    b.textContent=c;
    b.title='U+'+c.codePointAt(0).toString(16).toUpperCase().padStart(4,'0');
    b.onclick=()=>{
      document.querySelectorAll('.ob').forEach(x=>x.classList.remove('on'));
      b.classList.add('on');
      S.orn=c;
      document.getElementById('custOrn').value='';
      up();gen();
    };
    g.appendChild(b);
  });
}

function applyPreset(p){
  S.colors.light={...p.light};
  S.colors.dark={...p.dark};
  document.querySelectorAll('.tc').forEach(x=>x.classList.remove('on'));
  document.getElementById('tc-'+p.id).classList.add('on');
  syncColors();up();gen();
}

// ── COLOR SYNC ─────────────────────────────
function syncColors(){
  [['light','bg1','lbg1'],['light','bg2','lbg2'],['light','text','ltx'],['light','ornament','lorn'],
   ['dark','bg1','dbg1'],['dark','bg2','dbg2'],['dark','text','dtx'],['dark','ornament','dorn']].forEach(([m,k,id])=>{
    const v=S.colors[m][k];
    const sw=document.getElementById('sw-'+id);
    const hx=document.getElementById('hx-'+id);
    const cp=document.getElementById('cp-'+id);
    if(sw)sw.style.background=v;
    if(hx)hx.value=v;
    if(cp)cp.value=v;
  });
  updGPB();
}

function updGPB(){
  const gl=document.getElementById('gpbl');
  const gd=document.getElementById('gpbd');
  const dir=cssDir(S.grad);
  if(gl)gl.style.background=`linear-gradient(${dir},${S.colors.light.bg1},${S.colors.light.bg2})`;
  if(gd)gd.style.background=`linear-gradient(${dir},${S.colors.dark.bg1},${S.colors.dark.bg2})`;
}

function pc(id){document.getElementById('cp-'+id).click()}
function ci(mode,key,val){
  S.colors[mode][key]=val;
  document.getElementById('hx-'+(mode[0]+key.replace('ornament','orn').replace('text','tx').replace('bg1','bg1').replace('bg2','bg2'))).value=val;
  document.getElementById('sw-'+(mode[0]+key.replace('ornament','orn').replace('text','tx').replace('bg1','bg1').replace('bg2','bg2'))).style.background=val;
  updGPB();up();gen();
}
function hx(mode,key,val){
  if(!/^#[0-9a-fA-F]{6}$/.test(val))return;
  const sid=mode[0]+key.replace('ornament','orn').replace('text','tx');
  S.colors[mode][key]=val;
  document.getElementById('sw-'+sid).style.background=val;
  document.getElementById('cp-'+sid).value=val;
  updGPB();up();gen();
}

// ── CSS GRAD DIR ───────────────────────────
function cssDir(d){
  return{tr:'to bottom right',b:'to bottom',r:'to right',bl:'to bottom left'}[d]||'to bottom right';
}

// ── PREVIEW ────────────────────────────────
const FMAP={
  'Georgia-Italic':['Georgia',true],'Georgia':['Georgia',false],
