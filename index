};

const date    = new Date();
const dateStr = \`\${date.getFullYear()}\${pad(date.getMonth()+1)}\${pad(date.getDate())}\`;
const jwUrl   = \`https://www.jw.org/finder?srcid=jwlshare&wtlocale=\${cfg.wtLocale.toUpperCase()}&prefer=lang&alias=daily-text&date=\${dateStr}\`;

const item   = await loadText();
const widget = createWidget(item);

if (config.runsInWidget) {
