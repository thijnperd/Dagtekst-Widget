<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dagelijkse Tekst — Widget Builder</title>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{--bg:#0c0e13;--s1:#141720;--s2:#1c2030;--s3:#242840;--bd:#ffffff0d;--bd2:#ffffff18;--bd3:#ffffff28;--acc:#c8a255;--acc2:#c8a25520;--acc3:#c8a25538;--tx:#ede9e0;--txm:#9a96a8;--txf:#4a4860;--r4:4px;--r8:8px;--r12:12px;--r20:20px;font-family:'Outfit',sans-serif}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--tx);height:100dvh;overflow:hidden;display:grid;grid-template-rows:52px 1fr}
header{display:flex;align-items:center;padding:0 20px;border-bottom:1px solid var(--bd);background:var(--s1);gap:14px;z-index:10}
.logo{display:flex;align-items:center;gap:8px;font-size:14px;font-weight:600;letter-spacing:-.02em}
.logo-dot{width:7px;height:7px;border-radius:50%;background:var(--acc)}
.logo-sub{color:var(--txm);font-size:11px;font-weight:400}
header .sp{flex:1}
.btn-primary{background:var(--acc);color:#0c0e13;border:none;border-radius:var(--r8);padding:7px 16px;font-family:inherit;font-size:12px;font-weight:600;cursor:pointer;transition:opacity .15s,transform .1s;letter-spacing:.01em}
.btn-primary:hover{opacity:.88}
.btn-primary:active{transform:scale(.97)}
.main{display:grid;grid-template-columns:340px 1fr;overflow:hidden}
/* LEFT */
.left{border-right:1px solid var(--bd);display:flex;flex-direction:column;overflow:hidden}
.tabs{display:flex;gap:2px;padding:10px 12px;border-bottom:1px solid var(--bd);background:var(--s1);flex-shrink:0}
.tab{flex:1;background:none;border:1px solid transparent;border-radius:var(--r4);color:var(--txm);font-family:inherit;font-size:11px;font-weight:500;padding:5px 2px;cursor:pointer;transition:all .15s}
.tab:hover{color:var(--tx)}
.tab.on{background:var(--acc2);color:var(--acc);border-color:var(--acc3)}
.scroll{overflow-y:auto;flex:1;padding:12px;display:flex;flex-direction:column;gap:10px}
.scroll::-webkit-scrollbar{width:3px}
.scroll::-webkit-scrollbar-thumb{background:var(--bd3);border-radius:4px}
/* SECTIONS */
.sec{background:var(--s1);border:1px solid var(--bd);border-radius:var(--r12);overflow:hidden}
.sec-h{display:flex;align-items:center;padding:11px 13px;font-size:11px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:var(--txm);cursor:pointer;user-select:none;gap:6px}
.sec-h svg{margin-left:auto;transition:transform .2s;flex-shrink:0}
.sec.on .sec-h svg{transform:rotate(180deg)}
.sec.on .sec-h{border-bottom:1px solid var(--bd)}
.sec-b{display:none;padding:13px;gap:11px;flex-direction:column}
.sec.on .sec-b{display:flex}
/* PANELS */
.panel{display:none}
.panel.on{display:contents}
/* FORM */
.f{display:flex;flex-direction:column;gap:5px}
.f label,.fl{font-size:11px;font-weight:500;color:var(--txm)}
.f input[type=text],.f input[type=number],.f select,.inp{background:var(--s2);border:1px solid var(--bd2);border-radius:var(--r8);color:var(--tx);font-family:inherit;font-size:12px;padding:7px 9px;outline:none;transition:border-color .15s;width:100%}
.f input:focus,.f select:focus,.inp:focus{border-color:var(--acc)}
.f select option{background:#1c2030}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}
/* COLOR FIELD */
.cf{display:flex;flex-direction:column;gap:5px}
.cw{display:flex;align-items:center;gap:7px;background:var(--s2);border:1px solid var(--bd2);border-radius:var(--r8);padding:5px 9px;transition:border-color .15s;cursor:pointer}
.cw:focus-within{border-color:var(--acc)}
.cs{width:18px;height:18px;border-radius:var(--r4);border:1px solid rgba(255,255,255,.12);flex-shrink:0;cursor:pointer;position:relative;overflow:hidden}
.cs input[type=color]{opacity:0;position:absolute;inset:0;width:100%;height:100%;cursor:pointer;border:none;padding:0}
.ch{background:none;border:none;color:var(--tx);font-family:'JetBrains Mono',monospace;font-size:11px;outline:none;flex:1;min-width:0}
/* SLIDER */
.sf{display:flex;flex-direction:column;gap:5px}
.slrow{display:flex;justify-content:space-between;align-items:center}
.slrow label{font-size:11px;font-weight:500;color:var(--txm)}
.slval{font-size:11px;font-family:'JetBrains Mono',monospace;color:var(--acc)}
input[type=range]{-webkit-appearance:none;width:100%;height:4px;background:var(--s3);border-radius:2px;outline:none;cursor:pointer}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:14px;height:14px;border-radius:50%;background:var(--acc);cursor:pointer;border:2px solid var(--bg);transition:transform .1s}
input[type=range]::-webkit-slider-thumb:hover{transform:scale(1.2)}
/* ORNAMENT PICKER */
.og{display:grid;grid-template-columns:repeat(6,1fr);gap:5px}
.ob{aspect-ratio:1;background:var(--s2);border:1px solid var(--bd2);border-radius:var(--r8);color:var(--tx);font-size:20px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .15s;line-height:1;font-family:Georgia,serif}
.ob:hover{border-color:var(--acc3);background:var(--acc2)}
.ob.on{border-color:var(--acc);background:var(--acc2);color:var(--acc)}
/* THEME GRID */
.tg{display:grid;grid-template-columns:1fr 1fr;gap:7px}
.tc{border-radius:var(--r8);overflow:hidden;cursor:pointer;border:2px solid transparent;transition:all .2s}
.tc:hover{transform:translateY(-1px);border-color:var(--bd3)}
.tc.on{border-color:var(--acc)}
.tp{height:48px;display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative}
.tp-orn{font-size:22px;font-family:Georgia,serif;opacity:.45;position:absolute;top:3px;left:50%;transform:translateX(-50%);line-height:1}
.tp-txt{font-size:9px;font-family:Georgia,serif;font-style:italic;opacity:.8;margin-top:8px}
.tn{background:rgba(0,0,0,.3);padding:3px 7px;font-size:10px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:rgba(255,255,255,.65)}
/* MODE TOGGLE */
.mt{display:flex;gap:3px;background:var(--s2);padding:3px;border-radius:var(--r8);margin-bottom:3px}
.mb{flex:1;background:none;border:none;border-radius:6px;padding:5px;font-family:inherit;font-size:11px;font-weight:500;color:var(--txm);cursor:pointer;transition:all .15s;display:flex;align-items:center;justify-content:center;gap:4px}
.mb.on{background:var(--s1);color:var(--tx)}
/* RIGHT */
.right{display:flex;flex-direction:column;align-items:center;justify-content:flex-start;gap:24px;padding:28px 24px;overflow-y:auto;background:var(--bg)}
.pctrl{display:flex;gap:8px;flex-wrap:wrap;justify-content:center}
.cg{display:flex;gap:2px;background:var(--s1);border:1px solid var(--bd);border-radius:var(--r8);padding:3px}
.cb{background:none;border:none;border-radius:6px;padding:5px 11px;font-family:inherit;font-size:11px;font-weight:500;color:var(--txm);cursor:pointer;transition:all .15s;display:flex;align-items:center;gap:4px}
.cb:hover{color:var(--tx)}
.cb.on{background:var(--s2);color:var(--tx)}
/* WIDGET STAGE */
.ws{display:flex;align-items:center;justify-content:center}
.wp{border-radius:22px;overflow:hidden;display:flex;flex-direction:column;transition:width .35s cubic-bezier(.34,1.56,.64,1),height .35s cubic-bezier(.34,1.56,.64,1);box-shadow:0 24px 60px rgba(0,0,0,.6),0 0 0 1px rgba(255,255,255,.05);position:relative}
.wp.sm{width:165px;height:165px}
.wp.md{width:355px;height:165px}
.wp.lg{width:355px;height:355px}
.wo{text-align:center;line-height:1;font-family:Georgia,serif;transition:all .2s;flex-shrink:0}
.wt{text-align:center;line-height:1.45;font-family:Georgia,serif;transition:all .2s;flex:1;display:flex;align-items:center;justify-content:center}
.wti{text-align:center}
.wd{font-size:9px;font-family:Georgia,serif;font-style:italic}
/* CODE */
.co{width:100%;max-width:600px}
.co-hdr{display:flex;align-items:center;justify-content:space-between;margin-bottom:7px}
.co-title{font-size:11px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:var(--txm)}
.btn-copy{background:var(--s2);border:1px solid var(--bd2);border-radius:var(--r8);color:var(--txm);font-family:inherit;font-size:11px;font-weight:500;padding:5px 12px;cursor:pointer;transition:all .15s;display:flex;align-items:center;gap:5px}
.btn-copy:hover{color:var(--tx);border-color:var(--bd3)}
.btn-copy.done{color:#4ade80;border-color:#4ade8030;background:#4ade8010}
.code-ta{width:100%;height:170px;background:var(--s1);border:1px solid var(--bd);border-radius:var(--r12);color:var(--txm);font-family:'JetBrains Mono',monospace;font-size:10.5px;line-height:1.65;padding:13px;resize:none;outline:none;transition:border-color .15s}
.code-ta:focus{border-color:var(--bd3)}
/* DIVIDER */
.div{height:1px;background:var(--bd);margin:0 -13px}
/* BADGE */
.badge{display:inline-flex;align-items:center;background:var(--acc2);color:var(--acc);border-radius:var(--r4);padding:2px 6px;font-size:10px;font-weight:600}
/* HINT */
.hint{font-size:11px;color:var(--txf);line-height:1.5}
/* GRADIENT PREVIEW BAR */
.gpb{height:32px;border-radius:var(--r8);border:1px solid var(--bd2);transition:all .3s;margin-top:2px}
/* CHECKMARK ani */
@keyframes ck{0%{transform:scale(0)}60%{transform:scale(1.2)}100%{transform:scale(1)}}
.done svg{animation:ck .3s ease}
/* Subtle fade in */
.panel.on>*{animation:fi .2s ease}
@keyframes fi{from{opacity:0;transform:translateY(3px)}to{opacity:1;transform:translateY(0)}}

/* ── MOBILE ──────────────────────────────── */
@media (max-width: 700px) {
  body{
    height:100dvh;
    overflow:hidden;
    grid-template-rows:48px 1fr 56px;
  }
  header{
    padding:0 14px;
  }
  .logo-sub{ display:none; }
  .btn-primary{
    font-size:11px;
    padding:6px 12px;
  }
  /* Main becomes single full-height column */
  .main{
    grid-template-columns:1fr;
    overflow:hidden;
    position:relative;
  }
  /* Left & right become full-screen swappable panels */
  .left, .right{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    transition:opacity .2s ease, transform .2s ease;
    overflow-y:auto;
    overflow-x:hidden;
    border:none;
  }
  /* Active mobile view */
  .left{  display:flex; z-index:1; }
  .right{ display:flex; flex-direction:column; align-items:center; z-index:0; padding:18px 16px; gap:18px; }

  /* Hidden state */
  .mob-hidden{
    opacity:0;
    pointer-events:none;
    transform:translateX(8px);
    z-index:0 !important;
  }
  /* Shown state */
  .mob-visible{
    opacity:1;
    pointer-events:auto;
    transform:translateX(0);
    z-index:1 !important;
  }

  /* Right panel: code section full width */
  .co{ width:100%; max-width:100%; }
  .code-ta{ height:200px; font-size:10px; }

  /* Widget stage doesn't need to center in a giant space */
  .ws{ width:100%; justify-content:center; }

  /* Tabs in left panel: make touch-friendly */
  .tabs{ padding:8px 10px; gap:3px; }
  .tab{ padding:7px 2px; font-size:10.5px; }

  /* Bottom navigation bar */
  .mob-nav{
    display:flex;
    background:var(--s1);
    border-top:1px solid var(--bd);
    z-index:100;
  }
  .mob-nav-btn{
    flex:1;
    background:none;
    border:none;
    color:var(--txm);
    font-family:inherit;
    font-size:10px;
    font-weight:500;
    cursor:pointer;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    gap:4px;
    padding:8px 4px;
    transition:color .15s;
    letter-spacing:.02em;
  }
  .mob-nav-btn svg{ flex-shrink:0; }
  .mob-nav-btn.on{ color:var(--acc); }
  .mob-nav-btn.on svg{ stroke:var(--acc); }

  /* Slightly taller touch targets on sliders */
  input[type=range]{ height:6px; }
  input[type=range]::-webkit-slider-thumb{ width:18px; height:18px; }

  /* Row grids: keep 2-col but allow wrap on very small screens */
  .row2{ grid-template-columns:1fr 1fr; }
  .row3{ grid-template-columns:1fr 1fr 1fr; }

  /* Preview controls wrap nicely */
  .pctrl{ gap:6px; }

  /* Ornament grid: 8 per row on mobile for more items */
  .og{ grid-template-columns:repeat(8,1fr); }
}

/* Hide mob-nav on desktop */
.mob-nav{ display:none; }
</style>
</head>
<body>

<header>
  <div class="logo"><div class="logo-dot"></div>Widget Builder <span class="logo-sub">Dagelijkse Tekst</span></div>
  <div class="sp"></div>
  <button class="btn-primary" id="btnExport" onclick="doExport()">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:inline;vertical-align:middle;margin-right:5px"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
    Exporteer Script
  </button>
</header>

<div class="main">
<!-- LEFT PANEL -->
<div class="left">
  <div class="tabs">
    <button class="tab on" onclick="sw('themes',this)">Thema&apos;s</button>
    <button class="tab" onclick="sw('colors',this)">Kleuren</button>
    <button class="tab" onclick="sw('type',this)">Tekst</button>
    <button class="tab" onclick="sw('orn',this)">Ornament</button>
    <button class="tab" onclick="sw('misc',this)">Overig</button>
  </div>

  <div class="scroll">

    <!-- THEMES PANEL -->
    <div class="panel on" id="pan-themes">
      <div class="sec on">
        <div class="sec-h" onclick="tgl(this)">Preset thema's <svg width="11" height="11" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></div>
        <div class="sec-b"><div class="tg" id="themeGrid"></div></div>
      </div>
    </div>

    <!-- COLORS PANEL -->
    <div class="panel" id="pan-colors">
      <div class="mt">
        <button class="mb on" id="cml" onclick="setCM('light')">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><line x1="12" y1="2" x2="12" y2="4"/><line x1="12" y1="20" x2="12" y2="22"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="2" y1="12" x2="4" y2="12"/><line x1="20" y1="12" x2="22" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          Licht modus
        </button>
        <button class="mb" id="cmd" onclick="setCM('dark')">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          Donker modus
        </button>
      </div>

      <div class="sec on" id="cpLight">
        <div class="sec-h" onclick="tgl(this)">Licht — achtergrond <svg width="11" height="11" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></div>
        <div class="sec-b">
          <div class="row2">
            <div class="cf"><label class="fl">Boven (bg1)</label><div class="cw" onclick="pc('lbg1')"><div class="cs" id="sw-lbg1"><input type="color" id="cp-lbg1" oninput="ci('light','bg1',this.value)"></div><input class="ch" id="hx-lbg1" maxlength="7" oninput="hx('light','bg1',this.value)"></div></div>
            <div class="cf"><label class="fl">Onder (bg2)</label><div class="cw" onclick="pc('lbg2')"><div class="cs" id="sw-lbg2"><input type="color" id="cp-lbg2" oninput="ci('light','bg2',this.value)"></div><input class="ch" id="hx-lbg2" maxlength="7" oninput="hx('light','bg2',this.value)"></div></div>
          </div>
          <div class="gpb" id="gpbl"></div>
          <div class="row2">
            <div class="cf"><label class="fl">Tekst</label><div class="cw" onclick="pc('ltx')"><div class="cs" id="sw-ltx"><input type="color" id="cp-ltx" oninput="ci('light','text',this.value)"></div><input class="ch" id="hx-ltx" maxlength="7" oninput="hx('light','text',this.value)"></div></div>
            <div class="cf"><label class="fl">Ornament</label><div class="cw" onclick="pc('lorn')"><div class="cs" id="sw-lorn"><input type="color" id="cp-lorn" oninput="ci('light','ornament',this.value)"></div><input class="ch" id="hx-lorn" maxlength="7" oninput="hx('light','ornament',this.value)"></div></div>
          </div>
        </div>
      </div>

      <div class="sec on" id="cpDark">
        <div class="sec-h" onclick="tgl(this)">Donker — achtergrond <svg width="11" height="11" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></div>
        <div class="sec-b">
          <div class="row2">
            <div class="cf"><label class="fl">Boven (bg1)</label><div class="cw" onclick="pc('dbg1')"><div class="cs" id="sw-dbg1"><input type="color" id="cp-dbg1" oninput="ci('dark','bg1',this.value)"></div><input class="ch" id="hx-dbg1" maxlength="7" oninput="hx('dark','bg1',this.value)"></div></div>
            <div class="cf"><label class="fl">Onder (bg2)</label><div class="cw" onclick="pc('dbg2')"><div class="cs" id="sw-dbg2"><input type="color" id="cp-dbg2" oninput="ci('dark','bg2',this.value)"></div><input class="ch" id="hx-dbg2" maxlength="7" oninput="hx('dark','bg2',this.value)"></div></div>
          </div>
          <div class="gpb" id="gpbd"></div>
          <div class="row2">
            <div class="cf"><label class="fl">Tekst</label><div class="cw" onclick="pc('dtx')"><div class="cs" id="sw-dtx"><input type="color" id="cp-dtx" oninput="ci('dark','text',this.value)"></div><input class="ch" id="hx-dtx" maxlength="7" oninput="hx('dark','text',this.value)"></div></div>
            <div class="cf"><label class="fl">Ornament</label><div class="cw" onclick="pc('dorn')"><div class="cs" id="sw-dorn"><input type="color" id="cp-dorn" oninput="ci('dark','ornament',this.value)"></div><input class="ch" id="hx-dorn" maxlength="7" oninput="hx('dark','ornament',this.value)"></div></div>
          </div>
        </div>
      </div>

      <div class="sec on">
        <div class="sec-h" onclick="tgl(this)">Verloop richting <svg width="11" height="11" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></div>
        <div class="sec-b">
          <div class="f"><label>Richting</label>
            <select id="selGrad" onchange="S.grad=this.value;up();gen()">
              <option value="tr">Diagonaal (links-boven → rechts-onder)</option>
              <option value="b">Verticaal (boven → onder)</option>
              <option value="r">Horizontaal (links → rechts)</option>
              <option value="bl">Diagonaal (rechts-boven → links-onder)</option>
            </select>
          </div>
        </div>
      </div>
    </div>

    <!-- TYPE PANEL -->
    <div class="panel" id="pan-type">
      <div class="sec on">
        <div class="sec-h" onclick="tgl(this)">Lettertype <svg width="11" height="11" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></div>
        <div class="sec-b">
          <div class="f"><label>Font familie</label>
            <select id="selFont" onchange="S.font=this.value;up();gen()">
              <option value="Georgia-Italic">Georgia Italic (standaard)</option>
              <option value="Georgia">Georgia Regular</option>
              <option value="TimesNewRomanPS-ItalicMT">Times New Roman Italic</option>
              <option value="TimesNewRomanPSMT">Times New Roman</option>
              <option value="Palatino-Italic">Palatino Italic</option>
              <option value="Palatino-Roman">Palatino Roman</option>
              <option value="Baskerville-Italic">Baskerville Italic</option>
              <option value="Baskerville">Baskerville</option>
              <option value="HelveticaNeue-Light">Helvetica Neue Light</option>
              <option value="HelveticaNeue">Helvetica Neue</option>
              <option value="HelveticaNeue-Italic">Helvetica Neue Italic</option>
              <option value="AvenirNext-Regular">Avenir Next</option>
              <option value="AvenirNext-Italic">Avenir Next Italic</option>
              <option value="GillSans-Italic">Gill Sans Italic</option>
              <option value="GillSans">Gill Sans</option>
              <option value="Futura-Medium">Futura Medium</option>
              <option value="Verdana">Verdana</option>
              <option value="ArialMT">Arial</option>
              <option value="Noteworthy-Light">Noteworthy Light</option>
              <option value="SnellRoundhand">Snell Roundhand</option>
              <option value="MarkerFelt-Thin">Marker Felt</option>
              <option value="Chalkboard SE">Chalkboard SE</option>
            </select>
          </div>
        </div>
