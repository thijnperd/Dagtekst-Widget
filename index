  fontName: "${S.font}",
  fontSizeLarge:  ${S.fs.l},
  fontSizeMedium: ${S.fs.m},
  fontSizeSmall:  ${S.fs.s},

  ornamentChar:    "\\u${ornHex}",
  ornamentSize:    ${S.ornSize},
  ornamentOpacity: ${S.ornOp},

  dateOrnament:    "\\u${dateHex}",
  dateOpacity:     ${S.dateOp},
  dateFontSize:    ${S.dateFs},

  widgetPadding:   ${S.pad},
  topSpacer:       ${S.tsp},
  minScale:        ${S.scale},

  light: {
    bg1:      new Color("${S.colors.light.bg1}"),
