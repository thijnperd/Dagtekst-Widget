   light:{bg1:'#f0c8d0',bg2:'#d8a0a8',text:'#fff0f2',ornament:'#fce8ec'},
   dark: {bg1:'#280c14',bg2:'#3c1820',text:'#fce8ec',ornament:'#e090a0'}},
