function createWidget(item) {
  const scripture = extractScripture(item);
  const w = new ListWidget();
  w.url = jwUrl;
  w.setPadding(cfg.widgetPadding, cfg.widgetPadding + 2, cfg.widgetPadding, cfg.widgetPadding + 2);

  const g = new LinearGradient();
  g.startPoint = ${spStart};
  g.endPoint   = ${spEnd};
  g.colors     = [
    Color.dynamic(cfg.light.bg1, cfg.dark.bg1),
    Color.dynamic(cfg.light.bg2, cfg.dark.bg2),
  ];
  g.locations  = [0, 1];
  w.backgroundGradient = g;

  const ornamentColor = Color.dynamic(cfg.light.ornament, cfg.dark.ornament);

  const topRow = w.addStack();
  topRow.layoutHorizontally();
  topRow.addSpacer();
  const orn = topRow.addText(cfg.ornamentChar);
  orn.font        = new Font("Georgia", cfg.ornamentSize);
  orn.textColor   = ornamentColor;
  orn.textOpacity = cfg.ornamentOpacity;
  topRow.addSpacer();

  w.addSpacer(cfg.topSpacer);

  const fontSize = config.widgetFamily === "small"
    ? cfg.fontSizeSmall
    : config.widgetFamily === "large"
    ? cfg.fontSizeLarge
    : cfg.fontSizeMedium;

  const txt = w.addText(scripture);
  txt.font               = new Font(cfg.fontName, fontSize);
  txt.textColor          = Color.dynamic(cfg.light.text, cfg.dark.text);
  txt.centerAlignText();
  txt.minimumScaleFactor = cfg.minScale;
  txt.lineLimit          = 0;

  w.addSpacer();

  const bottomRow = w.addStack();
  bottomRow.layoutHorizontally();
  bottomRow.addSpacer();
  const datumTxt = bottomRow.addText(\`\${cfg.dateOrnament}  \${formatDate(date)}\`);
  datumTxt.font        = new Font("Georgia-Italic", cfg.dateFontSize);
  datumTxt.textColor   = ornamentColor;
  datumTxt.textOpacity = cfg.dateOpacity;

  return w;
}

async function loadText() {
  try {
    const url = \`https://wol.jw.org/wol/dt/r\${cfg.rsconf}/lp-\${cfg.wtLocale.toLowerCase()}/\${date.getFullYear()}/\${pad(date.getMonth()+1)}/\${pad(date.getDate())}\`;
    const req = new Request(url);
    const json = await req.loadJSON();
    return json.items[0];
  } catch(e) { return null; }
}

function extractScripture(item) {
  if (!item) return "Tekst kon niet worden geladen.";
  const html    = item.content || "";
  const regex   = /<p[^>]*>(.*?)<\\/p>/s;
  const matches = html.match(regex);
  const raw     = (matches && matches[1]) ? matches[1] : "Geen tekst gevonden.";
  return raw.replace(/<[^>]*>/gm, '').trim();
}

function pad(n) { return String(n).padStart(2, '0'); }

function formatDate(d) {
  const m = ["jan","feb","mrt","apr","mei","jun","jul","aug","sep","okt","nov","dec"];
  return \`\${d.getDate()} \${m[d.getMonth()]} \${d.getFullYear()}\`;
}`;

